{
  "name": "tarley-travel",
  "version": "0.1.0",
  "description": "Tarley Travel LLC website",
  "scripts": {
    "dev": "astro dev",
    "assets": "tsx scripts/brand.ts && tsx scripts/images.ts && tsx scripts/og.ts",
    "build": "astro build && tsx scripts/postbuild.ts && tsx scripts/budget.ts",
    "preview": "astro preview --port 4321",
    "typecheck": "astro check",
    "lint": "eslint . --max-warnings 0 && tsx scripts/check-source.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "placeholders": "tsx scripts/placeholders.ts",
    "lighthouse": "tsx scripts/lighthouse.ts",
    "screenshots": "playwright test --config playwright.screenshots.config.ts",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test && npm run build && npm run test:e2e",
    "serve": "tsx scripts/serve.ts",
    "budget": "tsx scripts/budget.ts",
    "fonts": "bash scripts/fonts.sh",
    "check:links": "tsx scripts/check-links.ts",
    "credits": "tsx scripts/credits.ts",
    "preview:copy": "tsx scripts/preview.ts",
    "deploy": "npm run build && wrangler deploy"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/231AG/traley-travel-agency.git"
  },
  "bugs": {
    "url": "https://github.com/231AG/traley-travel-agency/issues"
  },
  "homepage": "https://github.com/231AG/traley-travel-agency#readme",
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.3.5",
    "tailwindcss": "^4.3.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@fontsource/cinzel": "^5.3.0",
    "@fontsource/playfair-display": "^5.3.0",
    "@fontsource/poppins": "^5.3.0",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.4",
    "eslint": "^10.12.0",
    "eslint-plugin-astro": "^1.7.0",
    "globals": "^17.13.0",
    "lighthouse": "^13.5.0",
    "prettier": "^3.9.9",
    "prettier-plugin-astro": "^1.1.0",
    "sharp": "^0.35.5",
    "simple-icons": "^16.33.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.3",
    "wrangler": "^4.147.0"
  },
  "private": true,
  "type": "module",
  "engines": {
    "node": "22.x"
  }
}
