---
import { conciergePage, meta, images, ctas } from "@content/site";
import Picture from "@components/Picture.astro";
import Icon from "@components/Icon.astro";
import { whatsappUrl } from "@lib/quote/whatsapp";
import Base from "@layouts/Base.astro";
import FeatureGrid from "@components/FeatureGrid.astro";
import PageHeader from "@components/PageHeader.astro";
import SectionTitle from "@components/SectionTitle.astro";
import WithQuote from "@components/WithQuote.astro";
---

<Base meta={meta.concierge}>
  <PageHeader quote image={images.monrovia} title={conciergePage.title} lead={conciergePage.lead} />
  <WithQuote initial="concierge" title={conciergePage.formTitle}>
    <section class="mb-14" aria-labelledby="fleet-title">
      <SectionTitle id="fleet-title">{conciergePage.fleetTitle}</SectionTitle>
      <p class="mt-3 text-muted">{conciergePage.fleetText}</p>
      <ul class="mt-6 grid gap-6 sm:grid-cols-2">
        {conciergePage.fleet.map((car) => (
          <li class="min-w-0">
            <Picture
              image={car.image}
              sizes="(min-width: 64rem) 320px, (min-width: 40rem) 45vw, 90vw"
              class="aspect-[3/4] w-full rounded-md bg-mist object-contain"
            />
            <h3 class="mt-4 font-sans text-lg font-semibold">{car.name}</h3>
            <a
              href={whatsappUrl(
                `Hello Tarley Travel, I'd like to ask about renting the ${car.name}. Please send availability, rates and rental terms.`,
              )}
              target="_blank"
              rel="noopener noreferrer"
              class="btn btn-outline mt-3 text-sm"
            >
              <Icon name="whatsapp" size={18} />
              {conciergePage.fleetCta}
              <span class="sr-only">{ctas.newTab}</span>
            </a>
          </li>
        ))}
      </ul>
    </section>
    <section aria-labelledby="included-title">
      <SectionTitle id="included-title">{conciergePage.includedTitle}</SectionTitle>
      <FeatureGrid items={conciergePage.included} />
    </section>
    <section class="mt-14" aria-labelledby="how-title">
      <SectionTitle id="how-title">{conciergePage.howTitle}</SectionTitle>
      <ol class="reveal-stagger mt-6 grid gap-5" data-reveal-columns="8">
        {conciergePage.how.map((step, index) => (
          <li class="flex gap-4">
            <span
              class="font-numeral w-6 shrink-0 text-2xl leading-none font-bold text-gold-text"
              aria-hidden="true"
            >
              {index + 1}
            </span>
            <span>{step}</span>
          </li>
        ))}
      </ol>
    </section>
  </WithQuote>
</Base>
