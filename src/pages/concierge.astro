---
import { conciergePage, meta, images } from "@content/site";
import Base from "@layouts/Base.astro";
import FeatureGrid from "@components/FeatureGrid.astro";
import PageHeader from "@components/PageHeader.astro";
import SectionTitle from "@components/SectionTitle.astro";
import WithQuote from "@components/WithQuote.astro";
---

<Base meta={meta.concierge}>
  <PageHeader
    quote
    image={images.concierge}
    title={conciergePage.title}
    lead={conciergePage.lead}
  />
  <WithQuote initial="concierge" title={conciergePage.formTitle}>
    <section aria-labelledby="included-title">
      <SectionTitle id="included-title">{conciergePage.includedTitle}</SectionTitle>
      <FeatureGrid items={conciergePage.included} />
    </section>
    <section class="mt-14" aria-labelledby="how-title">
      <SectionTitle id="how-title">{conciergePage.howTitle}</SectionTitle>
      <ol class="reveal-stagger mt-6 grid gap-5" data-reveal-columns="8">
        {conciergePage.how.map((step, index) => (
          <li class="flex gap-4">
            <span
              class="font-numeral w-6 shrink-0 text-2xl leading-none font-bold text-gold-text"
              aria-hidden="true"
            >
              {index + 1}
            </span>
            <span>{step}</span>
          </li>
        ))}
      </ol>
    </section>
  </WithQuote>
</Base>
