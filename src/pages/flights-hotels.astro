---
import { flightsPage, meta } from "@content/site";
import BaseA from "@a/layouts/BaseA.astro";
import CheckList from "@a/components/CheckList.astro";
import FeatureGrid from "@a/components/FeatureGrid.astro";
import PageHeader from "@a/components/PageHeader.astro";
import SectionTitle from "@a/components/SectionTitle.astro";
import WithQuote from "@a/components/WithQuote.astro";
---

<BaseA meta={meta.flights}>
  <PageHeader quote title={flightsPage.title} lead={flightsPage.lead} />
  <WithQuote initial="flights" title={flightsPage.formTitle}>
    <section aria-labelledby="included-title">
      <SectionTitle id="included-title">{flightsPage.includedTitle}</SectionTitle>
      <FeatureGrid items={flightsPage.included} />
    </section>
    <section class="mt-14" aria-labelledby="pricing-title">
      <SectionTitle id="pricing-title">{flightsPage.pricingTitle}</SectionTitle>
      <CheckList items={flightsPage.pricing} />
    </section>
    <section
      id="packages"
      class="mt-14 scroll-mt-24 rounded-md border border-border bg-cream p-6"
      aria-labelledby="packages-title"
    >
      <SectionTitle id="packages-title">{flightsPage.packagesTitle}</SectionTitle>
      <p class="mt-3 text-muted">{flightsPage.packagesText}</p>
      <a href="#quote" class="btn btn-outline mt-5" data-quote-select="flights">
        {flightsPage.packagesCta}
      </a>
    </section>
  </WithQuote>
</BaseA>
