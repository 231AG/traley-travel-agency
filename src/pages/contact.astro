---
import { business, contactPage, ctas, meta, social, whatsappGreeting } from "@content/site";
import Base from "@layouts/Base.astro";
import PageHeader from "@components/PageHeader.astro";
import Icon from "@components/Icon.astro";
import { whatsappUrl } from "@lib/quote/whatsapp";

const m = contactPage.methods;
const mapUrl = `https://www.google.com/maps/embed?origin=mfe&pb=!1m2!2m1!1s${encodeURIComponent(business.addressLine)}`;
const methods = [
  { ...m.phone, href: business.phoneHref, label: business.phoneDisplay },
  { ...m.email, href: `mailto:${business.email}`, label: business.email },
];
---

<Base meta={meta.contact} jsonLd>
  <PageHeader title={contactPage.title} lead={contactPage.lead} />
  <div class="container-page py-12 md:py-16">
    <section
      class="grid gap-8 border-b border-border pb-12 lg:grid-cols-[minmax(0,1.15fr)_minmax(0,1fr)] lg:gap-16"
      aria-labelledby="contact-whatsapp"
    >
      <div class="min-w-0 border-l-4 border-gold pl-6 md:pl-8">
        <div class="flex items-center gap-3 text-gold-text">
          <Icon name="whatsapp" size={26} />
          <span class="text-sm font-semibold">{contactPage.fastest}</span>
        </div>
        <h2 id="contact-whatsapp" class="mt-4 text-3xl">
          {ctas.whatsappLong}
        </h2>
        <p class="mt-3 text-muted">{m.whatsapp.text}</p>
        <p class="mt-2 text-sm text-muted">{business.hoursShort}</p>
        <a
          href={whatsappUrl(whatsappGreeting)}
          target="_blank"
          rel="noopener noreferrer"
          class="btn btn-navy mt-6"
        >
          <Icon name="whatsapp" size={18} />
          {business.phoneDisplay}
          <span class="sr-only">{ctas.newTab}</span>
        </a>
      </div>
      <div class="divide-y divide-border">
        {methods.map((method) => (
          <div class="flex min-w-0 gap-4 py-5 first:pt-0">
            <Icon name={method.icon} size={22} class="mt-1 shrink-0 text-gold-text" />
            <div class="min-w-0">
              <h2 class="font-sans text-lg font-semibold">{method.title}</h2>
              <p class="mt-1 text-sm text-muted">{method.text}</p>
              <a href={method.href} class="link inline-flex min-h-11 items-center break-all">
                {method.label}
              </a>
            </div>
          </div>
        ))}
      </div>
    </section>
    <section
      class="grid gap-8 py-12 lg:grid-cols-[minmax(0,1fr)_minmax(0,1.8fr)] lg:gap-12"
      aria-labelledby="map-title"
    >
      <div class="min-w-0">
        <h2 id="map-title" class="text-3xl">
          {contactPage.mapTitle}
        </h2>
        <address class="mt-5 flex gap-3 text-lg not-italic">
          <Icon name="pin" size={22} class="mt-1 shrink-0 text-gold-text" />
          {business.addressLine}
        </address>
        <div class="mt-7 border-y border-border py-5">
          <h3 class="flex items-center gap-2 font-sans text-base font-semibold">
            <Icon name="clock" size={18} />
            {contactPage.hoursTitle}
          </h3>
          <p class="mt-3 text-sm text-muted">{business.hours}</p>
          <p class="mt-2 text-sm text-muted">
            {contactPage.closedDay}: {contactPage.closed}
          </p>
        </div>
        <p class="mt-5 text-sm text-muted">{contactPage.mapNote}</p>
        <a
          href={whatsappUrl(contactPage.directionsMessage)}
          target="_blank"
          rel="noopener noreferrer"
          class="btn btn-outline mt-5"
        >
          <Icon name="pin" size={18} />
          {contactPage.directions}
          <span class="sr-only">{ctas.newTab}</span>
        </a>
      </div>
      <div class="min-w-0 overflow-hidden rounded-md border border-border bg-mist">
        <iframe
          src={mapUrl}
          title={contactPage.mapLabel}
          width="800"
          height="480"
          loading="eager"
          referrerpolicy="no-referrer-when-downgrade"
          allowfullscreen
          class="h-[360px] w-full border-0 md:h-[480px]"
        ></iframe>
      </div>
    </section>
    <section
      class="flex flex-wrap items-center justify-between gap-5 border-t border-border pt-7"
      aria-labelledby="follow-title"
    >
      <h2 id="follow-title" class="font-sans text-lg font-semibold">
        {contactPage.followTitle}
      </h2>
      <ul class="flex flex-wrap gap-6">
        {social.map((item) => (
          <li>
            <a
              href={item.href}
              target="_blank"
              rel="noopener noreferrer"
              class="flex min-h-11 items-center gap-2 font-medium text-navy hover:text-royal"
            >
              <Icon name={item.icon} size={20} />
              {item.label}
              <span class="sr-only">{ctas.newTab}</span>
            </a>
          </li>
        ))}
      </ul>
    </section>
  </div>
</Base>
