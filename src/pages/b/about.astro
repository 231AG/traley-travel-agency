---
import {
  aboutPage,
  business,
  ctas,
  images,
  meta,
  placeholders,
  whatsappGreeting,
} from "@content/site";
import BaseB from "@b/layouts/BaseB.astro";
import CtaBand from "@b/components/CtaBand.astro";
import ListRows from "@b/components/ListRows.astro";
import PageHeader from "@b/components/PageHeader.astro";
import Picture from "@shared/components/Picture.astro";
import Text from "@shared/components/Text.astro";
import { whatsappUrl } from "@shared/quote/whatsapp";
---

<BaseB meta={meta.about}>
  <PageHeader title={aboutPage.title} lead={aboutPage.lead} />
  <div class="container-page grid grid-cols-[minmax(0,1fr)] gap-16 py-14 md:py-20">
    <section
      class="grid grid-cols-[minmax(0,1fr)] gap-10 lg:grid-cols-[minmax(0,1fr)_24rem]"
      aria-labelledby="story-title"
    >
      <div>
        <h2 id="story-title" class="text-4xl">
          {aboutPage.storyTitle}
        </h2>
        <p class="mt-4 text-lg">
          <Text value={placeholders.about.token} />
        </p>
        <h3 class="mt-10 text-3xl">{aboutPage.teamTitle}</h3>
        <p class="mt-3 text-muted">
          <Text value={placeholders.team.token} />
        </p>
      </div>
      <Picture
        image={images.team}
        sizes="(min-width: 64rem) 384px, 100vw"
        class="aspect-[3/4] w-full object-cover"
        placeholderClass="photo-slot aspect-[3/4] w-full border-2 border-navy"
      />
    </section>
    <ListRows
      title={aboutPage.howWeWorkTitle}
      items={aboutPage.howWeWork.map((text) => ({ text }))}
    />
    <section
      class="grid grid-cols-[minmax(0,1fr)] gap-10 lg:grid-cols-[minmax(0,1fr)_24rem]"
      aria-labelledby="visit-title"
    >
      <div>
        <h2 id="visit-title" class="text-4xl">
          {aboutPage.visitTitle}
        </h2>
        <p class="mt-4 text-lg">{business.addressLine}</p>
        <p class="mt-1 text-muted">{business.hours}</p>
        <div class="mt-6 flex flex-wrap gap-3">
          <a
            href={business.mapsSearch}
            target="_blank"
            rel="noopener noreferrer"
            class="btn btn-line"
          >
            {ctas.mapsOpen}
            <span class="sr-only">{ctas.newTab}</span>
          </a>
          <a
            href={whatsappUrl(whatsappGreeting)}
            target="_blank"
            rel="noopener noreferrer"
            class="btn btn-navy"
          >
            {ctas.messageTeam}
            <span class="sr-only">{ctas.newTab}</span>
          </a>
        </div>
      </div>
      <Picture
        image={images.office}
        sizes="(min-width: 64rem) 384px, 100vw"
        class="aspect-[4/3] w-full object-cover"
        placeholderClass="photo-slot aspect-[4/3] w-full border-2 border-navy"
      />
    </section>
  </div>
  <CtaBand />
</BaseB>
