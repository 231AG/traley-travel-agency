---
import type { GetStaticPaths } from "astro";
import {
  ctas,
  destinationMeta,
  destinationPage,
  destinations,
  placeholders,
  visaPage,
  visaPageNote,
} from "@content/site";
import type { Destination } from "@shared/types";
import BaseB from "@b/layouts/BaseB.astro";
import Board from "@b/components/Board.astro";
import { withBase } from "@shared/paths";
import ListRows from "@b/components/ListRows.astro";
import Note from "@b/components/Note.astro";
import PageHeader from "@b/components/PageHeader.astro";
import QuotePanel from "@b/components/QuotePanel.astro";
import Text from "@shared/components/Text.astro";

export const getStaticPaths = (() =>
  destinations.map((destination) => ({
    params: { country: destination.slug },
    props: { destination },
  }))) satisfies GetStaticPaths;

interface Props {
  destination: Destination;
}

const { destination: d } = Astro.props;
const others = destinations.filter((other) => other.slug !== d.slug);
---

<BaseB meta={destinationMeta(d)}>
  <PageHeader
    quote
    title={`${d.name} ${destinationPage.titleSuffix}`}
    lead={visaPage.lead}
    breadcrumb={{ label: destinationPage.backToVisa, href: withBase("/b", "/visa") }}
  />
  <div class="container-page grid grid-cols-[minmax(0,1fr)] gap-16 py-14 md:py-20">
    <Board show="current" current={d.name} />
    <ListRows
      title={destinationPage.typesTitle}
      items={d.visaTypes.map((t) => ({ title: t.name, text: t.forWho }))}
    />
    <section aria-labelledby="requirements-title">
      <h2 id="requirements-title" class="text-4xl">
        {destinationPage.requirementsTitle}
      </h2>
      <div class="mt-6 grid gap-4">
        <Note text={visaPageNote} />
        <p class="text-muted">
          <Text value={placeholders.requirements.token} />
        </p>
      </div>
      <a
        href="#quote"
        class="btn btn-gold mt-6"
        data-quote-select="visa"
        data-quote-destination={d.name}
      >
        {`${destinationPage.cta} ${d.shortName}`}
      </a>
    </section>
    <section aria-labelledby="official-title">
      <h2 id="official-title" class="text-4xl">
        {destinationPage.officialTitle}
      </h2>
      <p class="mt-3">{destinationPage.officialText}</p>
      <a
        href={d.officialSource.href}
        target="_blank"
        rel="noopener noreferrer"
        class="link mt-2 inline-flex min-h-11 items-center"
      >
        {d.officialSource.label}
        <span class="sr-only">{ctas.newTab}</span>
      </a>
    </section>
    <QuotePanel initial="visa" title={visaPage.formTitle} destination={d.name} />
    <nav aria-labelledby="others-title">
      <h2 id="others-title" class="text-4xl">
        {destinationPage.otherTitle}
      </h2>
      <ul class="mt-4 flex flex-wrap gap-x-6">
        {others.map((other) => (
          <li>
            <a
              href={withBase("/b", `/visa/${other.slug}`)}
              class="link inline-flex min-h-11 items-center"
            >
              {other.name}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
</BaseB>
