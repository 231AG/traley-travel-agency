---
import { flightsPage, meta } from "@content/site";
import BaseB from "@b/layouts/BaseB.astro";
import Board from "@b/components/Board.astro";
import ListRows from "@b/components/ListRows.astro";
import PageHeader from "@b/components/PageHeader.astro";
import QuotePanel from "@b/components/QuotePanel.astro";
---

<BaseB meta={meta.flights}>
  <PageHeader quote title={flightsPage.title} lead={flightsPage.lead} />
  <div class="container-page grid grid-cols-[minmax(0,1fr)] gap-16 py-14 md:py-20">
    <ListRows title={flightsPage.includedTitle} items={flightsPage.included} />
    <ListRows
      title={flightsPage.pricingTitle}
      items={flightsPage.pricing.map((text) => ({ text }))}
      numbered
    />
    <section
      id="packages"
      class="scroll-mt-6 border-l-4 border-gold bg-cream p-6"
      aria-labelledby="packages-title"
    >
      <h2 id="packages-title" class="text-3xl">
        {flightsPage.packagesTitle}
      </h2>
      <p class="mt-3 max-w-2xl">{flightsPage.packagesText}</p>
      <a href="#quote" class="btn btn-navy mt-5" data-quote-select="flights">
        {flightsPage.packagesCta}
      </a>
    </section>
    <Board show="destinations" />
    <QuotePanel initial="flights" title={flightsPage.formTitle} />
  </div>
</BaseB>
