---
import { steps, stepsIntro } from "@content/site";
---

<section
  id="how-it-works"
  class="scroll-mt-20 bg-cream py-16 md:py-24"
  aria-labelledby="steps-title"
>
  <div class="container-page">
    <h2 id="steps-title" class="max-w-3xl text-3xl md:text-4xl">
      {stepsIntro.title}
    </h2>
    <ol class="mt-12 grid gap-8 sm:grid-cols-2 lg:grid-cols-4">
      {steps.map((step, index) => (
        <li class="border-t-2 border-navy pt-5">
          <span
            class="font-numeral text-3xl leading-none font-bold text-gold-text md:text-4xl"
            aria-hidden="true"
          >
            {index + 1}
          </span>
          <h3 class="mt-4 font-sans text-lg font-semibold">{step.title}</h3>
          <p class="mt-2 text-muted">{step.text}</p>
        </li>
      ))}
    </ol>
  </div>
</section>
