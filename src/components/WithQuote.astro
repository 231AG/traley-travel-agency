---
/** Inner-page body: content on the left, the quote card in a sticky column on the right. */
import type { QuoteType } from "@lib/types";
import QuoteCard from "@components/quote/QuoteCard.astro";

interface Props {
  initial: QuoteType;
  title: string;
  destination?: string;
}

const { initial, title, destination } = Astro.props;
---

<div class="container-page grid grid-cols-[minmax(0,1fr)] gap-12 py-14 md:py-20 lg:grid-cols-[minmax(0,1fr)_26rem] lg:gap-16">
  <div class="min-w-0">
    <slot />
  </div>
  <aside class="lg:sticky lg:top-24 lg:self-start">
    <QuoteCard
      initial={initial}
      title={title}
      notchClass="bg-white border border-border"
      destination={destination}
      animate={false}
      inline
    />
  </aside>
</div>
