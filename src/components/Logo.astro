---
/** The cropped Logo A wordmark (see scripts/brand.ts). Never recolored; a white plate is used on navy. */
import { business } from "@content/site";

interface Props {
  href: string;
  /** Puts the logo on a white plate, for navy backgrounds. */
  plate?: boolean;
}

const { href, plate = false } = Astro.props;
---

<a
  href={href}
  class:list={["inline-flex shrink-0 items-center", plate && "rounded-sm bg-white px-2 py-1.5"]}
>
  <picture>
    <source type="image/webp" srcset="/brand/wordmark-96.webp 2x, /brand/wordmark-144.webp 3x" />
    <img
      src="/brand/wordmark-96.png"
      srcset="/brand/wordmark-96.png 2x, /brand/wordmark-144.png 3x"
      width="143"
      height="48"
      class="h-11 w-auto md:h-12"
      alt={`${business.name}, home`}
    />
  </picture>
</a>
