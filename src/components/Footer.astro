---
import { business, ctas, footer, social, whatsappGreeting } from "@content/site";
import Icon from "@components/Icon.astro";
import { whatsappUrl } from "@lib/quote/whatsapp";
import Logo from "@components/Logo.astro";
import PhotoCredits from "@components/PhotoCredits.astro";

const linkClass =
  "inline-flex min-h-11 items-center text-sm text-on-navy-muted hover:text-white hover:underline hover:underline-offset-4";
const headingClass = "font-sans text-sm font-semibold text-white";
---

<footer class="on-dark bg-navy-deep text-on-navy-muted">
  <div class="container-page grid grid-cols-2 gap-x-6 gap-y-10 pt-14 pb-10 lg:grid-cols-[1.3fr_1fr_1fr_1.3fr_1fr]">
    <div class="col-span-2 lg:col-span-1">
      <Logo href="/" plate />
      <p class="mt-4 text-sm">{business.tagline}</p>
    </div>
    <nav aria-labelledby="footer-services">
      <h2 id="footer-services" class={headingClass}>
        {footer.columns.services}
      </h2>
      <ul class="mt-2">
        {footer.services.map((item) => (
          <li>
            <a href={item.href} class={linkClass}>
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
    <nav aria-labelledby="footer-company">
      <h2 id="footer-company" class={headingClass}>
        {footer.columns.company}
      </h2>
      <ul class="mt-2">
        {footer.company.map((item) => (
          <li>
            <a href={item.href} class={linkClass}>
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
    <div class="col-span-2 sm:col-span-1">
      <h2 class={headingClass}>{footer.columns.contact}</h2>
      <ul class="mt-2">
        <li>
          <a
            href={whatsappUrl(whatsappGreeting)}
            target="_blank"
            rel="noopener noreferrer"
            class={linkClass}
          >
            {footer.whatsappLabel} {business.phoneDisplay}
            <span class="sr-only">{ctas.newTab}</span>
          </a>
        </li>
        <li>
          <a href={business.phoneHref} class={linkClass}>
            {ctas.call}
          </a>
        </li>
        <li>
          <a href={`mailto:${business.email}`} class={`${linkClass} break-all`}>
            {business.email}
          </a>
        </li>
      </ul>
      <p class="mt-2 text-sm">{business.addressLine}</p>
      <p class="mt-1 text-sm">{business.hours}</p>
    </div>
    <div>
      <h2 class={headingClass}>{footer.columns.follow}</h2>
      <ul class="mt-2">
        {social.map((item) => (
          <li>
            <a
              href={item.href}
              target="_blank"
              rel="noopener noreferrer"
              class={`${linkClass} gap-2`}
            >
              <Icon name={item.icon} size={18} />
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </div>
  </div>
  <div class="border-t border-white/10">
    <div class="container-page flex flex-wrap items-center justify-between gap-4 py-5 text-sm">
      <div>
        <p>{footer.copyright}</p>
        <PhotoCredits linkClass="underline underline-offset-2 hover:text-white" />
      </div>
      <a href="#top" class={`${linkClass} gap-2`}>
        <Icon name="arrow-up" size={18} />
        {ctas.backToTop}
      </a>
    </div>
  </div>
</footer>
