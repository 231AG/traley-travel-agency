---
import { about, business, ctas, images, whatsappGreeting } from "@content/site";
import Picture from "@components/Picture.astro";
import Text from "@components/Text.astro";
import Icon from "@components/Icon.astro";
import { whatsappUrl } from "@lib/quote/whatsapp";

const details = [
  { label: about.labels.office, value: business.addressLine },
  { label: about.labels.hours, value: business.hours },
  { label: about.labels.phone, value: business.phoneDisplay, href: business.phoneHref },
  { label: about.labels.email, value: business.email, href: `mailto:${business.email}` },
];
---

<section
  id="about"
  class="scroll-mt-20 border-y border-border bg-white py-16 md:py-20"
  aria-labelledby="about-title"
>
  <div class="container-page">
    <div class="grid items-center gap-8 lg:grid-cols-[minmax(0,1fr)_minmax(0,1fr)] lg:gap-14">
      <div class="min-w-0">
        <p class="mb-4 text-sm font-semibold text-gold-text">{about.eyebrow}</p>
        <h2 id="about-title" class="reveal text-3xl md:text-4xl">
          {about.title}
        </h2>
        <p class="mt-5 max-w-xl text-muted">
          <Text value={about.story} />
        </p>
        <a
          href={whatsappUrl(whatsappGreeting)}
          target="_blank"
          rel="noopener noreferrer"
          class="btn btn-navy mt-7"
        >
          <Icon name="whatsapp" size={18} />
          {ctas.messageTeam}
          <span class="sr-only">{ctas.newTab}</span>
        </a>
      </div>
      <div class="min-w-0 overflow-hidden rounded-md">
        <Picture
          image={images.monrovia}
          sizes="(min-width: 64rem) 560px, 100vw"
          class="aspect-[4/3] w-full object-cover"
          placeholderClass="photo-slot aspect-[4/3] w-full"
        />
      </div>
    </div>
    <dl class="mt-10 grid gap-6 border-t border-border pt-7 sm:grid-cols-2 lg:grid-cols-4">
      {details.map((d) => (
        <div>
          <dt class="text-sm font-semibold text-navy">{d.label}</dt>
          <dd class="mt-2 text-sm break-words text-muted">
            {d.href ? (
              <a href={d.href} class="link inline-flex min-h-11 items-center break-all">
                {d.value}
              </a>
            ) : (
              d.value
            )}
          </dd>
        </div>
      ))}
    </dl>
  </div>
</section>
