---
import { about, business, ctas, images, whatsappGreeting } from "@content/site";
import Picture from "@components/Picture.astro";
import Text from "@components/Text.astro";
import { whatsappUrl } from "@lib/quote/whatsapp";

const details = [
  { label: about.labels.office, value: business.addressLine },
  { label: about.labels.hours, value: business.hours },
  { label: about.labels.phone, value: business.phoneDisplay, href: business.phoneHref },
  { label: about.labels.email, value: business.email, href: `mailto:${business.email}` },
];
---

<section id="about" class="scroll-mt-20 bg-cream py-16 md:py-24" aria-labelledby="about-title">
  <div class="container-page grid items-center gap-10 lg:grid-cols-2 lg:gap-16">
    <div>
      <h2 id="about-title" class="reveal text-3xl md:text-4xl">
        {about.title}
      </h2>
      <p class="reveal mt-5 text-lg">{about.lead}</p>
      <p class="mt-3 text-muted">
        <Text value={about.story} />
      </p>
      <dl class="reveal-stagger mt-8 grid gap-x-8 gap-y-5 sm:grid-cols-2" data-reveal-columns="2">
        {details.map((d) => (
          <div>
            <dt class="text-sm font-semibold text-navy">{d.label}</dt>
            <dd class="mt-1 flex min-h-11 items-center text-sm break-words text-muted">
              {d.href ? (
                <a href={d.href} class="link inline-flex min-h-11 items-center">
                  {d.value}
                </a>
              ) : (
                d.value
              )}
            </dd>
          </div>
        ))}
      </dl>
      <a
        href={whatsappUrl(whatsappGreeting)}
        target="_blank"
        rel="noopener noreferrer"
        class="btn btn-navy mt-8"
      >
        {ctas.messageTeam}
        <span class="sr-only">{ctas.newTab}</span>
      </a>
    </div>
    <Picture
      image={images.team}
      sizes="(min-width: 64rem) 560px, 100vw"
      class="aspect-[4/3] w-full rounded-md object-cover"
      placeholderClass="photo-slot aspect-[4/3] w-full rounded-md border border-border"
    />
  </div>
</section>
