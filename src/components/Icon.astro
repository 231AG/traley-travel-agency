---
import type { IconName } from "@lib/types";
import { icons } from "@lib/icons";

interface Props {
  name: IconName;
  class?: string;
  /** Size in px; icons are decorative unless a label is given. */
  size?: number;
  label?: string;
}

const { name, class: className, size = 24, label } = Astro.props;
const icon = icons[name];
---

<svg
  class={className}
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill={icon.fill ? "currentColor" : "none"}
  stroke={icon.fill ? "none" : "currentColor"}
  stroke-width="1.75"
  stroke-linecap="round"
  stroke-linejoin="round"
  role={label ? "img" : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : "true"}
  focusable="false"
>
  {icon.paths.map((d) => (
    <path d={d} />
  ))}
</svg>
