---
/**
 * Error summary, live status and fallback link under each quote form.
 * The submit button and the no-payment line are passed in as the default slot.
 */
import { quote, whatsappGreeting } from "@content/site";
import { whatsappUrl } from "@lib/quote/whatsapp";

interface Props {
  statusClass?: string;
}

const { statusClass = "mt-3 text-sm" } = Astro.props;
---

<p class="field-error mt-4" role="alert" data-quote-summary hidden></p>
<slot />
<div class={statusClass} data-quote-status>
  <p
    aria-live="polite"
    data-quote-status-text
    data-opened-text={quote.opened}
    data-blocked-text={quote.blocked}
  ></p>
  <a
    href={whatsappUrl(whatsappGreeting)}
    class="link inline-flex min-h-11 items-center"
    target="_blank"
    rel="noopener noreferrer"
    data-quote-fallback
    hidden
  >
    {quote.openFallback}
  </a>
</div>
