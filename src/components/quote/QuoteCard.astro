---
/**
 * The boarding-pass quote card. Markup only; behavior lives in
 * src/shared/quote/controller.ts and is wired through data attributes.
 */
import { business, quote } from "@content/site";
import type { QuoteType } from "@lib/types";
import Icon from "@components/Icon.astro";
import ConciergeFields from "@components/quote/ConciergeFields.astro";
import FlightFields from "@components/quote/FlightFields.astro";
import Stub from "./Stub.astro";
import FormFooter from "@components/quote/FormFooter.astro";
import VisaFields from "@components/quote/VisaFields.astro";

interface Props {
  /** Tab selected on load (inner pages open on their own service). */
  initial?: QuoteType;
  id?: string;
  title?: string;
  notchClass?: string;
  /** Preselected visa destination (visa destination pages). */
  destination?: string | undefined;
  /** The page-load rise animation is reserved for the homepage hero. */
  animate?: boolean;
  /** Inner pages: a bordered card on white instead of the floating hero card. */
  inline?: boolean;
}

const {
  initial = "flights",
  id = "quote",
  title = quote.title,
  notchClass,
  destination,
  animate = true,
  inline = false,
} = Astro.props;
const fields = { flights: FlightFields, visa: VisaFields, concierge: ConciergeFields };
---

<div
  id={id}
  class:list={[
    "on-light relative scroll-mt-24 self-center rounded-md bg-white text-ink",
    inline ? "border border-border shadow-card" : "shadow-quote",
    animate && "motion-safe:animate-rise",
  ]}
  data-quote
  data-initial={initial}
>
  <div class="p-5 sm:px-7 sm:py-6 lg:py-5">
    <h2 class="text-2xl">{title}</h2>
    <p class="mt-1 text-sm text-muted">{quote.subtitle}</p>
    <div class="mt-4 grid gap-2 rounded-md border border-border bg-cream p-3 text-sm text-muted sm:grid-cols-3">
      <span class="flex items-center gap-2">
        <Icon name="clock" size={18} class="shrink-0 text-gold-text" />
        Under 30 min
      </span>
      <span class="flex items-center gap-2">
        <Icon name="receipt" size={18} class="shrink-0 text-gold-text" />
        Receipts
      </span>
      <span class="flex items-center gap-2">
        <Icon name="pin" size={18} class="shrink-0 text-gold-text" />
        {business.city}
      </span>
    </div>

    <div
      role="tablist"
      aria-label={quote.tabsLabel}
      class="mt-4 grid grid-cols-3 gap-1 rounded-full border border-border-strong bg-cream p-1"
    >
      {quote.tabs.map((tab) => (
        <button
          type="button"
          role="tab"
          id={`${id}-tab-${tab.id}`}
          aria-controls={`${id}-panel-${tab.id}`}
          aria-selected={tab.id === initial ? "true" : "false"}
          tabindex={tab.id === initial ? 0 : -1}
          class="min-h-11 rounded-full text-sm font-semibold text-navy transition-colors hover:bg-white aria-selected:bg-navy aria-selected:text-white"
          data-quote-tab={tab.id}
        >
          {tab.label}
        </button>
      ))}
    </div>

    {quote.tabs.map((tab) => {
      const Fields = fields[tab.id];
      return (
        <div
          role="tabpanel"
          id={`${id}-panel-${tab.id}`}
          aria-labelledby={`${id}-tab-${tab.id}`}
          hidden={tab.id !== initial}
          data-quote-panel={tab.id}
        >
          <form class="mt-4 lg:mt-3" novalidate data-quote-form={tab.id}>
            {tab.id === "visa" ? (
              <VisaFields idPrefix={`${id}-visa`} selected={destination} />
            ) : (
              <Fields idPrefix={`${id}-${tab.id}`} />
            )}
            <FormFooter statusClass="mt-3 text-center text-sm">
              <button type="submit" class="btn btn-gold mt-5 w-full">
                <Icon name="whatsapp" size={20} />
                {quote.submit[tab.id]}
              </button>
              <p class="mt-2 text-center text-sm text-muted">{quote.noPayment}</p>
            </FormFooter>
          </form>
        </div>
      );
    })}
    <noscript>
      <p class="mt-4 text-sm text-muted">{quote.noscript}</p>
    </noscript>
  </div>
  <Stub notchClass={notchClass} initial={initial} destination={destination} />
</div>

<script>
  import { initQuote } from "@lib/quote/controller";

  initQuote();
</script>
