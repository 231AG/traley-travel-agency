---
import { destinations, quote } from "@content/site";
import { upcomingMonths } from "@lib/quote/months";
import Field from "./Field.astro";

interface Props {
  idPrefix: string;
  /** Destination chosen when the page loads. */
  selected?: string | undefined;
}

const { idPrefix: p, selected } = Astro.props;
const f = quote.fields;
---

<div class="grid gap-4">
  <Field id={`${p}-destination`} label={f.destination}>
    <select
      id={`${p}-destination`}
      name="destination"
      class="field-input"
      required
      data-stub-source="destination"
      aria-describedby={`${p}-destination-error`}
    >
      <option value="">{f.destinationPlaceholder}</option>
      {destinations.map((d) => (
        <option value={d.name} selected={d.name === selected}>
          {d.name}
        </option>
      ))}
      <option value={f.otherDestination}>{f.otherDestination}</option>
    </select>
  </Field>
  <div data-other-destination hidden>
    <Field id={`${p}-destinationOther`} label={f.otherCountry}>
      <input
        id={`${p}-destinationOther`}
        name="destinationOther"
        class="field-input"
        autocomplete="off"
        aria-describedby={`${p}-destinationOther-error`}
      />
    </Field>
  </div>
  <Field id={`${p}-reason`} label={f.reason}>
    <select id={`${p}-reason`} name="reason" class="field-input">
      <option value="">{f.choose}</option>
      {quote.reasons.map((reason) => (
        <option>{reason}</option>
      ))}
    </select>
  </Field>
  <Field id={`${p}-month`} label={f.month}>
    <select id={`${p}-month`} name="month" class="field-input" data-month-select>
      <option value="">{f.monthUnsure}</option>
      {upcomingMonths(new Date()).map((m) => (
        <option value={m.value}>{m.label}</option>
      ))}
    </select>
  </Field>
</div>
