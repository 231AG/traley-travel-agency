---
import type { IconName } from "@lib/types";
import Icon from "@components/Icon.astro";

interface Props {
  items: readonly { title: string; text: string; icon?: IconName }[];
}

const { items } = Astro.props;
---

<ul class="reveal-stagger mt-6 grid gap-4 sm:grid-cols-2">
  {items.map((item) => (
    <li class="rounded-md border border-border p-5">
      {item.icon && (
        <span class="mb-3 inline-flex size-11 items-center justify-center rounded-full bg-navy text-gold">
          <Icon name={item.icon} size={22} />
        </span>
      )}
      <h3 class="font-sans text-lg font-semibold">{item.title}</h3>
      <p class="mt-1 text-muted">{item.text}</p>
    </li>
  ))}
</ul>
