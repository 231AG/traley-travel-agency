---
import { ctas, hero, images, whatsappGreeting } from "@content/site";
import Icon from "@components/Icon.astro";
import Picture from "@components/Picture.astro";
import { whatsappUrl } from "@lib/quote/whatsapp";
import QuoteCard from "@components/quote/QuoteCard.astro";
---

<section class="on-dark relative overflow-hidden bg-navy" aria-labelledby="hero-title">
  <div class="absolute inset-y-0 right-0 hidden w-1/2 lg:block">
    <Picture
      image={images.hero}
      sizes="50vw"
      media="(min-width: 64rem)"
      priority
      class="size-full object-cover object-[70%_center]"
      placeholderClass="photo-slot size-full"
    />
    <div class="absolute inset-0 bg-linear-to-r from-navy from-0% to-transparent to-40%"></div>
  </div>
  <div class="container-page relative grid grid-cols-[minmax(0,1fr)] gap-10 pt-10 pb-14 md:pt-14 lg:grid-cols-[1fr_minmax(0,29rem)] lg:gap-16 lg:py-[clamp(0.75rem,3vh,3.5rem)]">
    <div class="self-center">
      <h1
        id="hero-title"
        class="text-4xl tracking-tight text-white motion-safe:animate-settle md:text-5xl"
      >
        {hero.title}
      </h1>
      <p class="mt-5 max-w-xl text-lg text-on-navy-muted motion-safe:animate-rise motion-safe:[animation-delay:120ms]">
        {hero.subtitle}
      </p>
      <div class="mt-8 flex flex-wrap gap-3 motion-safe:animate-rise motion-safe:[animation-delay:220ms]">
        <a href="#quote" class="btn btn-gold w-full sm:w-auto" data-quote-focus>
          {ctas.quote}
        </a>
        <a
          href={whatsappUrl(whatsappGreeting)}
          target="_blank"
          rel="noopener noreferrer"
          class="btn btn-outline-light w-full sm:w-auto"
        >
          <Icon name="whatsapp" size={18} />
          {ctas.whatsapp}
          <span class="sr-only">{ctas.newTab}</span>
        </a>
      </div>
      <p class="mt-8 flex max-w-md items-start gap-2 text-sm text-on-navy-muted motion-safe:animate-rise motion-safe:[animation-delay:320ms]">
        <Icon name="pin" size={20} class="mt-0.5 shrink-0 text-gold" />
        {hero.location}
      </p>
    </div>
    <QuoteCard notchClass="bg-navy lg:hidden" />
  </div>
</section>
