---
import { services, servicesIntro } from "@content/site";
import ServiceCard from "./ServiceCard.astro";
---

<section id="services" class="scroll-mt-20 py-16 md:py-24" aria-labelledby="services-title">
  <div class="container-page">
    <h2 id="services-title" class="reveal max-w-xl text-3xl md:text-4xl">
      {servicesIntro.title}
    </h2>
    <p class="mt-4 max-w-xl text-lg text-muted">{servicesIntro.text}</p>
    <div class="reveal-stagger mt-12 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
      {services.map((service) => (
        <ServiceCard service={service} />
      ))}
    </div>
  </div>
</section>
