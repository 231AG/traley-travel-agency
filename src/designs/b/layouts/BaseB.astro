---
import "../../../styles/b.css";
import bigShoulders from "../../../assets/fonts/big-shoulders-700.woff2?url";
import { ctas } from "@content/site";
import type { PageMeta } from "@shared/types";
import Head from "@shared/components/Head.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import FloatingWhatsApp from "../components/FloatingWhatsApp.astro";

interface Props {
  meta: PageMeta;
}

const { meta } = Astro.props;
---

<!doctype html>
<html lang="en" id="top">
  <head>
    <Head meta={meta} noindex preloadFonts={[bigShoulders]} />
  </head>
  <body>
    <a href="#main" class="sr-only-focusable btn btn-navy">
      {ctas.skip}
    </a>
    <Header />
    <main id="main" tabindex="-1" class="focus:outline-none">
      <slot />
    </main>
    <Footer />
    <FloatingWhatsApp />
  </body>
</html>
