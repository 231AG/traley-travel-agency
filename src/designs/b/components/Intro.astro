---
import { hero } from "@content/site";
import Icon from "@shared/components/Icon.astro";
---

<section class="container-page pt-10 pb-8 md:pt-16 md:pb-12" aria-labelledby="hero-title">
  <h1 id="hero-title" class="max-w-5xl text-5xl leading-[0.95] md:text-6xl lg:text-7xl">
    {hero.title}
  </h1>
  <div class="mt-6 flex flex-col gap-4 md:flex-row md:items-end md:justify-between">
    <p class="max-w-2xl text-lg md:text-xl">{hero.subtitle}</p>
    <p class="flex items-start gap-2 text-muted md:max-w-xs">
      <Icon name="pin" size={20} class="mt-0.5 shrink-0 text-gold-text" />
      {hero.location}
    </p>
  </div>
</section>
