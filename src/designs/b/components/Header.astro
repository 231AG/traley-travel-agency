---
import { ctas, nav, whatsappGreeting } from "@content/site";
import Icon from "@shared/components/Icon.astro";
import { withBase } from "@shared/paths";
import { whatsappUrl } from "@shared/quote/whatsapp";
import Logo from "@shared/components/Logo.astro";

const current = Astro.url.pathname.replace(/\.html$/, "");
const isCurrent = (href: string) =>
  !href.includes("#") && (current === href || current.startsWith(`${href}/`)) ? "page" : undefined;
/** On the narrowest phones "How it works" drops out so the nav fits one line; it stays in the footer. */
const links = nav.map((item) => ({ ...item, href: withBase("/b", item.href) }));
---

<header class="border-b-2 border-navy bg-white">
  <div class="container-page flex min-h-16 flex-wrap items-center justify-between gap-x-6 md:min-h-20">
    <Logo href={withBase("/b", "/")} />
    <nav aria-label="Main" class="order-last w-full md:order-none md:w-auto">
      <ul class="-mx-2 flex flex-wrap md:mx-0">
        {links.map((item) => (
          <li
            class:list={["shrink-0", item.href.endsWith("#how-it-works") && "max-[399px]:hidden"]}
          >
            <a
              href={item.href}
              class="inline-flex min-h-11 min-w-11 items-center justify-center px-1.5 text-sm font-bold sm:px-2 text-navy md:text-base underline-offset-8 hover:underline aria-[current=page]:underline aria-[current=page]:decoration-gold aria-[current=page]:decoration-[3px]"
              aria-current={isCurrent(item.href)}
            >
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
    <a
      href={whatsappUrl(whatsappGreeting)}
      target="_blank"
      rel="noopener noreferrer"
      class="btn btn-navy min-h-11 px-4"
    >
      <Icon name="whatsapp" size={18} />
      {ctas.whatsapp}
      <span class="sr-only">{ctas.newTab}</span>
    </a>
  </div>
</header>
