---
/**
 * Design B's quote form: a plain "check-in counter" panel under the board.
 * Same fields and behavior as Design A (shared controller and field markup).
 */
import { board, quote, whatsappGreeting } from "@content/site";
import type { QuoteType } from "@shared/types";
import Icon from "@shared/components/Icon.astro";
import ConciergeFields from "@shared/components/quote/ConciergeFields.astro";
import FlightFields from "@shared/components/quote/FlightFields.astro";
import VisaFields from "@shared/components/quote/VisaFields.astro";
import { whatsappUrl } from "@shared/quote/whatsapp";

interface Props {
  initial?: QuoteType;
  title?: string;
  destination?: string | undefined;
}

const { initial = "flights", title = board.formTitle, destination } = Astro.props;
const id = "quote";
const fields = { flights: FlightFields, visa: VisaFields, concierge: ConciergeFields };
---

<section
  id={id}
  class="scroll-mt-4 border-2 border-navy bg-cream"
  data-quote
  data-initial={initial}
  aria-labelledby="quote-title"
>
  <div class="grid gap-6 p-5 sm:p-8 lg:grid-cols-[16rem_minmax(0,1fr)] lg:gap-12">
    <div>
      <h2 id="quote-title" class="text-4xl">
        {title}
      </h2>
      <p class="mt-2 text-muted">{quote.subtitle}</p>
      <div
        role="tablist"
        aria-label={quote.tabsLabel}
        class="mt-6 grid grid-cols-3 gap-0 border-2 border-navy lg:grid-cols-1"
      >
        {quote.tabs.map((tab) => (
          <button
            type="button"
            role="tab"
            id={`${id}-tab-${tab.id}`}
            aria-controls={`${id}-panel-${tab.id}`}
            aria-selected={tab.id === initial ? "true" : "false"}
            tabindex={tab.id === initial ? 0 : -1}
            class="min-h-12 border-navy px-3 text-left font-board text-xl text-navy not-last:border-r-2 aria-selected:bg-navy aria-selected:text-gold lg:not-last:border-r-0 lg:not-last:border-b-2"
            data-quote-tab={tab.id}
          >
            {tab.label}
          </button>
        ))}
      </div>
    </div>
    <div>
      {quote.tabs.map((tab) => {
        const Fields = fields[tab.id];
        return (
          <div
            role="tabpanel"
            id={`${id}-panel-${tab.id}`}
            aria-labelledby={`${id}-tab-${tab.id}`}
            hidden={tab.id !== initial}
            data-quote-panel={tab.id}
          >
            <form novalidate data-quote-form={tab.id}>
              {tab.id === "visa" ? (
                <VisaFields idPrefix={`${id}-visa`} selected={destination} />
              ) : (
                <Fields idPrefix={`${id}-${tab.id}`} />
              )}
              <p class="field-error mt-4" role="alert" data-quote-summary hidden />
              <div class="mt-6 flex flex-wrap items-center gap-x-5 gap-y-3">
                <button type="submit" class="btn btn-gold">
                  <Icon name="whatsapp" size={20} />
                  {quote.submit[tab.id]}
                </button>
                <p class="text-sm text-muted">{quote.noPayment}</p>
              </div>
              <div class="mt-3 text-sm" data-quote-status>
                <p
                  aria-live="polite"
                  data-quote-status-text
                  data-opened-text={quote.opened}
                  data-blocked-text={quote.blocked}
                />
                <a
                  href={whatsappUrl(whatsappGreeting)}
                  class="link inline-flex min-h-11 items-center"
                  target="_blank"
                  rel="noopener noreferrer"
                  data-quote-fallback
                  hidden
                >
                  {quote.openFallback}
                </a>
              </div>
            </form>
          </div>
        );
      })}
      <noscript>
        <p class="mt-4 text-sm text-muted">{quote.noscript}</p>
      </noscript>
    </div>
  </div>
</section>

<script>
  import { initQuote } from "@shared/quote/controller";

  initQuote();
</script>
