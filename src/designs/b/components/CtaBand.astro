---
import { business, ctas, finalCta, whatsappGreeting } from "@content/site";
import Icon from "@shared/components/Icon.astro";
import { whatsappUrl } from "@shared/quote/whatsapp";
---

<section class="bg-gold py-14 md:py-20" aria-labelledby="cta-title">
  <div class="container-page flex flex-col gap-8 lg:flex-row lg:items-end lg:justify-between">
    <div class="max-w-3xl">
      <h2 id="cta-title" class="text-4xl md:text-6xl">
        {finalCta.title}
      </h2>
      <p class="mt-4 text-lg text-navy">{finalCta.text}</p>
    </div>
    <div class="flex shrink-0 flex-wrap gap-3">
      <a
        href={whatsappUrl(whatsappGreeting)}
        target="_blank"
        rel="noopener noreferrer"
        class="btn btn-navy"
      >
        <Icon name="whatsapp" size={18} />
        {ctas.whatsapp}
        <span class="sr-only">{ctas.newTab}</span>
      </a>
      <a href={business.phoneHref} class="btn btn-line">
        <Icon name="phone" size={18} />
        {ctas.call}
      </a>
    </div>
  </div>
</section>
