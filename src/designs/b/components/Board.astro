---
/**
 * The departures board: one row per destination, each with real buttons that
 * open the quote form already filled in. Shows no times, gates or prices.
 */
import { board, business, destinations } from "@content/site";
import { withBase } from "@shared/paths";

interface Props {
  /** Highlights one destination (visa destination pages). */
  current?: string;
  /** Where the buttons send people when the form is on this page. */
  quoteHref?: string;
  headingLevel?: "h1" | "h2";
}

const { current, quoteHref = "#quote", headingLevel = "h2" } = Astro.props;
const Heading = headingLevel;
const rows = [
  ...destinations.map((d) => ({
    name: d.name,
    purposes: d.purposes,
    href: withBase("/b", `/visa/${d.slug}`),
    value: d.name,
  })),
  { name: board.elsewhere.name, purposes: board.elsewhere.purposes, href: undefined, value: "" },
];
const buttonClass = "btn btn-board min-h-11 px-3 text-sm";
---

<section class="on-dark bg-navy text-white" aria-labelledby="board-title">
  <div class="flex flex-wrap items-baseline justify-between gap-2 border-b border-white/15 px-4 py-4 sm:px-6">
    <Heading id="board-title" class="font-board text-3xl text-gold md:text-4xl">
      {board.title}
    </Heading>
    <p class="text-sm text-on-navy-muted">{business.replyTime}</p>
  </div>
  <div
    class="hidden grid-cols-[minmax(0,1.2fr)_minmax(0,1fr)_auto] gap-4 border-b border-white/15 px-6 py-2 text-sm text-on-navy-muted md:grid"
    aria-hidden="true"
  >
    <span>{board.columns.destination}</span>
    <span>{board.columns.help}</span>
    <span class="w-[15.5rem]">{board.columns.ask}</span>
  </div>
  <ul>
    {rows.map((row) => (
      <li
        class:list={[
          "board-flip grid gap-x-4 gap-y-1.5 border-b border-white/10 px-4 py-3 sm:px-6 md:py-4 md:grid-cols-[minmax(0,1.2fr)_minmax(0,1fr)_auto] md:items-center",
          row.value && row.value === current && "bg-royal",
        ]}
      >
        <p class="font-board text-2xl leading-tight text-gold md:text-3xl">
          {row.href ? (
            <a
              href={row.href}
              class="inline-flex min-h-11 items-center hover:underline hover:underline-offset-4"
            >
              {row.name}
            </a>
          ) : (
            row.name
          )}
        </p>
        <p class="text-on-navy-muted">{row.purposes}</p>
        <div class="flex gap-2 md:w-[15.5rem] md:justify-end">
          <a
            href={quoteHref}
            class={buttonClass}
            data-quote-select="flights"
            data-quote-to={row.value}
          >
            {board.flight}
            {row.value && <span class="sr-only">, {row.name}</span>}
          </a>
          {row.value ? (
            <a
              href={quoteHref}
              class={buttonClass}
              data-quote-select="visa"
              data-quote-destination={row.value}
            >
              {board.visa}
              <span class="sr-only">, {row.name}</span>
            </a>
          ) : (
            <a href={quoteHref} class={buttonClass} data-quote-select="visa">
              {board.visa}
            </a>
          )}
        </div>
      </li>
    ))}
    <li class="board-flip grid gap-x-4 gap-y-2 bg-navy-deep px-4 py-5 sm:px-6 md:grid-cols-[minmax(0,1.2fr)_minmax(0,1fr)_auto] md:items-center">
      <p class="font-board text-2xl leading-tight text-white md:text-3xl">
        <a
          href={withBase("/b", "/concierge")}
          class="inline-flex min-h-11 items-center hover:underline hover:underline-offset-4"
        >
          {board.arriving.title}
        </a>
      </p>
      <p class="text-on-navy-muted">{board.arriving.text}</p>
      <div class="md:flex md:w-[15.5rem] md:justify-end">
        <a
          href={quoteHref}
          class="btn btn-gold min-h-11 px-4 text-sm"
          data-quote-select="concierge"
        >
          {board.arriving.action}
        </a>
      </div>
    </li>
  </ul>
</section>
