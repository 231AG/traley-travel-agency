---
import { board, trust } from "@content/site";
---

<section class="py-16 md:py-20" aria-labelledby="trust-title">
  <div class="container-page">
    <h2 id="trust-title" class="text-4xl md:text-5xl">
      {board.trustTitle}
    </h2>
    <ul class="mt-8 grid gap-8 sm:grid-cols-2 lg:grid-cols-4">
      {trust.map((item) => (
        <li class="border-l-4 border-gold pl-4">
          <p class="text-lg font-bold text-navy">{item.title}</p>
          <p class="mt-1 text-muted">{item.text}</p>
        </li>
      ))}
    </ul>
  </div>
</section>
