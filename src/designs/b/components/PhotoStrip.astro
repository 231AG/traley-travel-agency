---
/** A wide "window" crop between sections: the only photo treatment in Design B. */
import type { ImageSlot } from "@shared/types";
import Picture from "@shared/components/Picture.astro";

interface Props {
  image: ImageSlot;
}

const { image } = Astro.props;
---

<figure class="relative h-48 overflow-hidden bg-mist sm:h-64 lg:h-80">
  <Picture
    image={image}
    sizes="100vw"
    class="absolute inset-0 size-full object-cover object-[50%_40%]"
    placeholderClass="photo-slot absolute inset-0 size-full"
  />
</figure>
