---
import { about, business, ctas, images, whatsappGreeting } from "@content/site";
import Picture from "@shared/components/Picture.astro";
import Text from "@shared/components/Text.astro";
import { whatsappUrl } from "@shared/quote/whatsapp";

const rows = [
  { label: about.labels.office, value: business.addressLine },
  { label: about.labels.hours, value: business.hours },
  { label: about.labels.phone, value: business.phoneDisplay, href: business.phoneHref },
  { label: about.labels.email, value: business.email, href: `mailto:${business.email}` },
];
---

<section
  id="about"
  class="scroll-mt-6 border-t-2 border-navy py-16 md:py-24"
  aria-labelledby="about-title"
>
  <div class="container-page grid grid-cols-[minmax(0,1fr)] gap-10 lg:grid-cols-[minmax(0,1fr)_24rem] lg:gap-16">
    <div>
      <h2 id="about-title" class="text-4xl md:text-5xl">
        {about.title}
      </h2>
      <p class="mt-5 text-lg">{about.lead}</p>
      <p class="mt-3 text-muted">
        <Text value={about.story} />
      </p>
      <dl class="mt-8 border-t border-border">
        {rows.map((row) => (
          <div class="grid gap-1 border-b border-border py-3 sm:grid-cols-[12rem_minmax(0,1fr)]">
            <dt class="font-bold text-navy">{row.label}</dt>
            <dd class="break-words text-muted">
              {row.href ? (
                <a href={row.href} class="link inline-flex min-h-11 items-center">
                  {row.value}
                </a>
              ) : (
                row.value
              )}
            </dd>
          </div>
        ))}
      </dl>
      <a
        href={whatsappUrl(whatsappGreeting)}
        target="_blank"
        rel="noopener noreferrer"
        class="btn btn-navy mt-8"
      >
        {ctas.messageTeam}
        <span class="sr-only">{ctas.newTab}</span>
      </a>
    </div>
    <Picture
      image={images.team}
      sizes="(min-width: 64rem) 384px, 100vw"
      class="aspect-[3/4] w-full object-cover"
      placeholderClass="photo-slot aspect-[3/4] w-full border-2 border-navy"
    />
  </div>
</section>
