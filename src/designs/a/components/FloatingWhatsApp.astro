---
import { ctas, whatsappGreeting } from "@content/site";
import Icon from "@shared/components/Icon.astro";
import { whatsappUrl } from "@shared/quote/whatsapp";
---

<a
  href={whatsappUrl(whatsappGreeting)}
  target="_blank"
  rel="noopener noreferrer"
  class="fixed right-4 bottom-4 z-30 inline-flex size-14 items-center justify-center rounded-full btn-gold shadow-quote focus-ring-dual transition-opacity data-[hidden]:pointer-events-none data-[hidden]:opacity-0 md:right-6 md:bottom-6"
  data-floating-whatsapp
>
  <Icon name="whatsapp" size={28} />
  <span class="sr-only">
    {ctas.whatsappLong} {ctas.newTab}
  </span>
</a>
