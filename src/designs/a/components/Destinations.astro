---
import { destinations, destinationsIntro, visaNote } from "@content/site";
import Icon from "@shared/components/Icon.astro";

interface Props {
  /** Where "Start a request" sends people: the quote card on this page. */
  quoteHref?: string;
  title?: string;
}

const { quoteHref = "#quote", title = destinationsIntro.title } = Astro.props;
---

<section id="destinations" class="scroll-mt-20 py-16 md:py-24" aria-labelledby="destinations-title">
  <div class="container-page">
    <h2 id="destinations-title" class="max-w-xl text-3xl md:text-4xl">
      {title}
    </h2>
    <ul class="mt-12 grid grid-cols-[repeat(2,minmax(0,1fr))] gap-3 sm:gap-4 lg:grid-cols-3">
      {destinations.map((d) => (
        <li class="flex flex-col rounded-md border border-border bg-white p-4 sm:p-5">
          <h3 class="text-xl">{d.name}</h3>
          <p class="mt-1 text-sm text-muted">{d.purposes}</p>
          <div class="mt-4 flex flex-wrap items-center gap-x-4 gap-y-1">
            <a
              href={quoteHref}
              class="inline-flex min-h-11 items-center text-sm font-semibold text-royal hover:underline hover:underline-offset-4"
              data-quote-select="visa"
              data-quote-destination={d.name}
            >
              {destinationsIntro.start}
              <span class="sr-only">, {d.name}</span>
            </a>
            <a
              href={`/visa/${d.slug}`}
              class="inline-flex min-h-11 items-center text-sm text-royal underline underline-offset-4"
            >
              {destinationsIntro.details}
              <span class="sr-only">, {d.name}</span>
            </a>
          </div>
        </li>
      ))}
    </ul>
    <p class="mt-8 flex items-start gap-3 rounded-md border border-border bg-cream px-5 py-4 text-sm text-ink">
      <Icon name="info" size={20} class="mt-0.5 shrink-0 text-navy" />
      {visaNote}
    </p>
  </div>
</section>
