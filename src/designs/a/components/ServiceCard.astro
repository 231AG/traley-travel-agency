---
import type { Service } from "@shared/types";
import Icon from "@shared/components/Icon.astro";
import Picture from "@shared/components/Picture.astro";

interface Props {
  service: Service;
}

const { service } = Astro.props;
---

<article class="flex flex-col overflow-hidden rounded-md border border-border bg-white shadow-card">
  <div class="relative aspect-[16/9] bg-mist">
    <Picture
      image={service.image}
      sizes="(min-width: 64rem) 380px, (min-width: 48rem) 50vw, 100vw"
      class="absolute inset-0 size-full object-cover"
      placeholderClass="photo-slot absolute inset-0 size-full"
    />
    <span class="absolute -bottom-6 left-6 inline-flex size-12 items-center justify-center rounded-full bg-navy text-gold ring-4 ring-white">
      <Icon name={service.icon} size={24} />
    </span>
  </div>
  <div class="flex flex-1 flex-col px-6 pt-10 pb-6">
    <h3 class="text-2xl">
      <a
        href={service.slug}
        class="inline-flex min-h-11 items-center hover:underline hover:underline-offset-4"
      >
        {service.title}
      </a>
    </h3>
    <p class="mt-3 text-muted">{service.summary}</p>
    <ul class="mt-5 grid gap-2.5">
      {service.checklist.map((item) => (
        <li class="flex gap-2.5">
          <Icon name="check" size={20} class="mt-0.5 shrink-0 text-gold-text" />
          <span>{item}</span>
        </li>
      ))}
    </ul>
    <div class="mt-auto pt-7">
      <a href="#quote" class="btn btn-outline" data-quote-select={service.id}>
        {service.cta}
      </a>
    </div>
  </div>
</article>
