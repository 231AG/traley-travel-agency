---
/**
 * The boarding-pass quote card. Markup only; behavior lives in
 * src/shared/quote/controller.ts and is wired through data attributes.
 */
import { quote, whatsappGreeting } from "@content/site";
import { whatsappUrl } from "@shared/quote/whatsapp";
import type { QuoteType } from "@shared/types";
import Icon from "@shared/components/Icon.astro";
import ConciergeFields from "./ConciergeFields.astro";
import FlightFields from "./FlightFields.astro";
import Stub from "./Stub.astro";
import VisaFields from "./VisaFields.astro";

interface Props {
  /** Tab selected on load (inner pages open on their own service). */
  initial?: QuoteType;
  id?: string;
  title?: string;
  notchClass?: string;
  /** Preselected visa destination (visa destination pages). */
  destination?: string | undefined;
  /** The page-load rise animation is reserved for the homepage hero. */
  animate?: boolean;
}

const {
  initial = "flights",
  id = "quote",
  title = quote.title,
  notchClass,
  destination,
  animate = true,
} = Astro.props;
const fields = { flights: FlightFields, visa: VisaFields, concierge: ConciergeFields };
---

<div
  id={id}
  class:list={[
    "on-light relative scroll-mt-24 self-center rounded-md bg-white text-ink shadow-quote",
    animate && "motion-safe:animate-rise",
  ]}
  data-quote
  data-initial={initial}
>
  <div class="p-5 sm:p-7">
    <h2 class="text-2xl">{title}</h2>
    <p class="mt-1 text-sm text-muted">{quote.subtitle}</p>

    <div
      role="tablist"
      aria-label={quote.tabsLabel}
      class="mt-5 grid grid-cols-3 gap-1 rounded-full border border-border-strong bg-cream p-1"
    >
      {quote.tabs.map((tab) => (
        <button
          type="button"
          role="tab"
          id={`${id}-tab-${tab.id}`}
          aria-controls={`${id}-panel-${tab.id}`}
          aria-selected={tab.id === initial ? "true" : "false"}
          tabindex={tab.id === initial ? 0 : -1}
          class="min-h-11 rounded-full text-sm font-semibold text-navy aria-selected:bg-navy aria-selected:text-white"
          data-quote-tab={tab.id}
        >
          {tab.label}
        </button>
      ))}
    </div>

    {quote.tabs.map((tab) => {
      const Fields = fields[tab.id];
      return (
        <div
          role="tabpanel"
          id={`${id}-panel-${tab.id}`}
          aria-labelledby={`${id}-tab-${tab.id}`}
          hidden={tab.id !== initial}
          data-quote-panel={tab.id}
        >
          <form class="mt-5" novalidate data-quote-form={tab.id}>
            <Fields idPrefix={`${id}-${tab.id}`} selected={destination} />
            <p class="field-error mt-4" role="alert" data-quote-summary hidden />
            <button type="submit" class="btn btn-gold mt-5 w-full">
              <Icon name="whatsapp" size={20} />
              {quote.submit[tab.id]}
            </button>
            <p class="mt-3 text-center text-sm text-muted">{quote.noPayment}</p>
            <div class="mt-3 text-center text-sm" data-quote-status>
              <p aria-live="polite" data-quote-status-text data-opened-text={quote.opened}></p>
              <a
                href={whatsappUrl(whatsappGreeting)}
                class="link mt-1 inline-flex min-h-11 items-center"
                target="_blank"
                rel="noopener noreferrer"
                data-quote-fallback
                hidden
              >
                {quote.openFallback}
              </a>
            </div>
          </form>
        </div>
      );
    })}
    <noscript>
      <p class="mt-4 text-sm text-muted">{quote.noscript}</p>
    </noscript>
  </div>
  <Stub notchClass={notchClass} />
</div>

<script>
  import { initQuote } from "@shared/quote/controller";

  initQuote();
</script>
