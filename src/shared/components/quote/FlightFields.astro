---
import { business, quote } from "@content/site";
import Field from "./Field.astro";

interface Props {
  idPrefix: string;
}

const { idPrefix: p } = Astro.props;
const f = quote.fields;
---

<div class="grid gap-4">
  <Field id={`${p}-from`} label={f.from}>
    <input
      id={`${p}-from`}
      name="from"
      class="field-input"
      autocomplete="off"
      value={business.airportShort}
      data-stub-source="from"
      aria-describedby={`${p}-from-error`}
    />
  </Field>
  <Field id={`${p}-to`} label={f.to}>
    <input
      id={`${p}-to`}
      name="to"
      class="field-input"
      autocomplete="off"
      placeholder={f.toPlaceholder}
      required
      data-stub-source="to"
      aria-describedby={`${p}-to-error`}
    />
  </Field>
  <div class="grid gap-3 min-[400px]:grid-cols-[repeat(2,minmax(0,1fr))]">
    <Field id={`${p}-departure`} label={f.departure} optional={f.optional}>
      <input
        id={`${p}-departure`}
        name="departure"
        type="date"
        class="field-input min-w-0"
        data-stub-source="departure"
        aria-describedby={`${p}-departure-error`}
      />
    </Field>
    <Field id={`${p}-return`} label={f.return} optional={f.optional} hint={f.returnHint}>
      <input
        id={`${p}-return`}
        name="return"
        type="date"
        class="field-input min-w-0"
        aria-describedby={`${p}-return-hint ${p}-return-error`}
      />
    </Field>
  </div>
  <Field id={`${p}-travelers`} label={f.travelers}>
    <select id={`${p}-travelers`} name="travelers" class="field-input">
      <option value="">{f.choose}</option>
      {quote.travelerOptions.map((option) => (
        <option>{option}</option>
      ))}
    </select>
  </Field>
</div>
